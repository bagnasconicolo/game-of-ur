# Copia in .env e adatta. Nessun segreto è necessario per l'esecuzione locale.
PORT=8787
HOST=127.0.0.1
DB_PATH=data/ur.db
# 1 in produzione dietro HTTPS
COOKIE_SECURE=0
# Origini aggiuntive ammesse per API/WebSocket (separate da virgola), es. https://ur.example.org
ALLOWED_ORIGINS=
# Durata del turno online in secondi e validità degli inviti
TURN_SECONDS=120
INVITE_SECONDS=600
